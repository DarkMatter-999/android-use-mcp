{
  "name": "@android-use/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --noEmit false && node --input-type=module -e \"import('node:fs').then(({ chmodSync }) => chmodSync('dist/src/cli.js', 0o755))\"",
    "test": "vitest run --root ../.. packages/mcp/ --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "bin": {
    "android-use-mcp": "./dist/src/cli.js"
  },
  "dependencies": {
    "@android-use/client": "workspace:*",
    "@android-use/protocol": "workspace:*",
    "@android-use/runtime": "workspace:*",
    "@android-use/transport": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "bonjour-service": "1.4.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
